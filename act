#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in
  train) shift; exec "$ROOT/act-train" "$@" ;;
  validate) shift; export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"; exec "$ROOT/.venv-act/bin/python" -m ai.train.validate_dataset "$@" ;;
  infer) shift; export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"; exec "$ROOT/.venv-act/bin/python" -m ai.serve.infer "$@" ;;
  execute) shift; export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"; exec "$ROOT/.venv-act/bin/python" -m ai.execute.main "$@" ;;
  task) shift; export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"; exec "$ROOT/.venv-act/bin/python" -m ai.execute.task_main "$@" ;;
  evaluate) shift; export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"; exec "$ROOT/.venv-act/bin/python" -m ai.evaluate.main "$@" ;;
  -h|--help|"") echo "Usage: ./act {train|validate|infer|execute|task|evaluate} [options]" ;;
  *) echo "Unknown ACT command: $1 (supported: train, validate, infer, execute, task, evaluate)" >&2; exit 2 ;;
esac
