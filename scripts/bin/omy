#!/usr/bin/env bash
set -eo pipefail
# Shared preflight only. Never start/stop containers or robot processes.
    SHARED="/opt/workspace/omy/cyclo_intelligence"

    case "${1:-}" in

        "")
            echo "=== OMY 실행 전 점검 ==="

            # Container names are fixed to the shared environment.
            for name in cyclo_intelligence open_manipulator; do
                if [[ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" != "true" ]]; then
                    echo "[STOP] $name 컨테이너가 실행 중이지 않음"
                    echo "공용 컨테이너를 자동으로 시작하지 않습니다."
                    return 1
                fi
            done

            echo "[OK] 공용 Docker 컨테이너 실행 중"

            if ! python3 -c 'import socket; s=socket.create_connection(("10.42.0.101", 7447), timeout=3); s.close()' 2>/dev/null; then
                echo "[STOP] OMY Zenoh 라우터 연결 불가"
                echo "로봇 PC 전원 및 네트워크를 확인하세요."
                return 1
            fi

            echo "[OK] OMY Zenoh 라우터 연결 가능"
            echo
            echo "로봇 구동 전 확인:"
            echo " - 다른 사용자 사용 여부"
            echo " - E-stop 및 작업 공간"
            echo " - 로봇 초기 자세와 Unpack 완료 여부"
            echo
            echo "텔레옵 자동 실행은 아직 연결하지 않았습니다."
            ;;


        status)
            echo "=== Shared OMY Containers ==="

            docker ps -a \
                --filter 'name=^/cyclo_intelligence$' \
                --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'

            docker ps -a \
                --filter 'name=^/open_manipulator$' \
                --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'

            echo
            echo "=== D405 ==="
            lsusb -d 8086:0b5b || true
            ;;

        doctor)
            echo "=== Shared OMY Environment ==="

            if [[ -x "$SHARED/cyclo.sh" ]]; then
                echo "[OK] Shared Cyclo launcher"
            else
                echo "[FAIL] Shared Cyclo launcher missing"
                return 1
            fi

            if docker info >/dev/null 2>&1; then
                echo "[OK] Docker accessible"
            else
                echo "[FAIL] Docker inaccessible"
                return 1
            fi

            if lsusb -d 8086:0b5b | grep -q 'RealSense'; then
                echo "[OK] D405 detected"
            else
                echo "[WARN] D405 not detected"
            fi
            ;;

        logs)
            docker logs --tail 100 cyclo_intelligence
            ;;

        help|-h|--help)
            echo "Team Capstone - OMY"
            echo
            echo "  omy           Safe preflight (no robot motion)"
            echo "  omy status    Shared container status"
            echo "  omy doctor    Environment check"
            echo "  omy logs      Cyclo logs"
            echo
            echo "Robot teleoperation is not configured yet."
            ;;

        *)
            echo "Unknown or not-yet-configured OMY command: $1" >&2
            echo "Run: omy --help"
            return 2
            ;;
    esac
